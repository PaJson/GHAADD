# ==============================================================================
# GHAADD - Core .gitignore Setup
# ==============================================================================

# --- 1. Python Cache & Compilation Artifacts ---
__pycache__/
modules/__pycache__/
*.pyc

# --- 2. Volatile Daemon Runtime & Status States ---
config.json.lock
.env.lock
config.json.*.tmp
ghaadd.lock
ghaadd.daemon.status.json
ghaadd.daemon.status.json.*.tmp
ghaadd.daemon.stderr.log
ghaadd.gui.lock
ghaadd.gui.show
ghaadd.gui.show.*.tmp
mapping.json.lock
mapping.json.*.tmp
mapping.json.v1.bak*
perf_baseline*.json

# --- 3. SQLite Local Write Records & Engine Caches ---
*.db
*.db-shm
*.db-wal

# --- 4. Environment Variables & Credentials ---
.env

# --- 5. Local and personal config files ---
config.json
mapping.json

# --- 6. Backups made by the Backup window / --backup ---
backups/

# --- 7. Coverage output ---
.coverage
htmlcov/

# --- 8. Claude Code personal settings ---
.claude/settings.local.json
