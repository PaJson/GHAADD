{
  "folders": {
    "ghaadd_root": "GHAADD",
    "processing": "Processing",
    "complete": "Complete",
    "partial": "Partial",
    "logs": "Logs"
  },
  "terminal_log": {
    "enabled": false,
    "max_file_mb": 10,
    "keep_files": 30
  },
  "mailbox": {
    "folder": "GitHubNotifications"
  },
  "paths": {
    "default_download_dir": "<set-local-download-path>",
    "default_subfolder": ""
  },
  "polling": {
    "enabled": true,
    "interval_seconds": 300,
    "jitter_min_seconds": 5,
    "jitter_max_seconds": 30
  },
  "processing": {
    "max_emails_to_process": 0,
    "recheck_intervals_minutes": [5, 15, 60, 360, 720, 1440],
    "destination_check_every_n_polls": 10,
    "default_limit": 10
  },
  "state": {
    "disable_state_persistence": false
  },
  "gui": {
    "refresh_seconds": 3,
    "status_message_seconds": 6,
    "tray": true,
    "minimize_to_tray": true,
    "notifications": true,
    "close_to_tray": false,
    "start_minimized": false,
    "start_daemon": false,
    "silenced_warning_types": ["API", "LIMIT"]
  }
}
