# Tokens the viewer accepts. Copy this file to ".env" in this folder (config/.env: the only file the viewer reads
# its tokens from) and replace the placeholders.
# The viewer re-reads the file whenever it changes: add a token to let a daemon in, delete one to lock it out.
# No restart is needed (with Docker the folder is mounted, see docker-compose.yml).
#
# Make a token with:  python main.py --new-viewer-token   (on the daemon's computer)
#
#   name=token    this token is only accepted from the daemon with that name (viewer.name in its config.json,
#                 by default the computer's name)
#   token         a plain token is accepted from any daemon (the same as *=token)
#
# Separate entries with a comma, a semicolon or a new line. A token must be at least 16 characters, so the
# placeholders below are refused until you replace them (the viewer says so when it starts).
GHAADD_VIEWER_TOKENS=home-pc=CHANGE-ME;nas=CHANGE-ME
